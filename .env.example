# Copy this file to .env and choose your own password (use the same one in the three places below).
# .env is git-ignored: NEVER commit real values.
# The host name "mongo" is the Docker service name (Docker networking), not localhost.

# Used by the Airflow DAG
MONGO_URI=mongodb://admin:choose_a_password@mongo:27017/?authSource=admin
MONGO_DB=currency_db
MONGO_COLLECTION=exchange_rates

# Used by the MongoDB container (creates the admin user the first time the volume is empty)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=choose_a_password

# Used by the Mongo Express container
ME_CONFIG_MONGODB_URL=mongodb://admin:choose_a_password@mongo:27017/?authSource=admin
ME_CONFIG_BASICAUTH=false
